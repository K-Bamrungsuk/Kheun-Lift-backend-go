DATABASE_URL=''
DIRECT_DATABASE_URL=''

PORT=
# Set false only for local development over HTTP.
COOKIE_SECURE=
# Prod only: ".<domain>" so app.<domain> (Next) also receives the cookie. Leave empty locally.
COOKIE_DOMAIN=

# Next app origin allowed to call this API with cookies, e.g. http://localhost:3002.
APP_ORIGIN=

# Cloudflare R2 bucket for profile images. Public URL is the bucket's r2.dev or custom domain, no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
